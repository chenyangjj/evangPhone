<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <IsFirstTimeProjectOpen>False</IsFirstTimeProjectOpen>
    <ActiveDebugFramework>net9.0-android</ActiveDebugFramework>
    <ActiveDebugProfile>Small Phone (Android 13.0 - API 33)</ActiveDebugProfile>
    <SelectedPlatformGroup>Emulator</SelectedPlatformGroup>
    <DefaultDevice>Small_Phone</DefaultDevice>
    <SelectedDevice>Small_Phone</SelectedDevice>
  </PropertyGroup>
</Project>